# Normaliza finais de linha: o repositório guarda tudo em LF (padrão do Linux,
# que é onde o GitHub Actions roda). Evita diffs "fantasma" entre Windows e CI.
* text=auto eol=lf

# Scripts do Windows precisam de CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binários: nunca mexer
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.jar binary
