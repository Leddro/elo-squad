# Copie para .env e preencha. Gere a chave em https://developer.riotgames.com
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Segredo das tarefas agendadas (POST /jobs/...). O Cloud Scheduler manda no
# cabecalho X-Jobs-Secret. Sem ele, as rotas /jobs ficam desligadas.
# JOBS_SECRET=troque-por-um-valor-aleatorio
