# ============================================================
# SEGREDOS — nunca versionar (a chave da Riot fica só no proxy)
# ============================================================
.env
.env.*
!.env.example
*.key
*.pem
google-services.json
GoogleService-Info.plist
firebase_options.dart
key.properties
*.jks
*.keystore

# ============================================================
# Flutter / Dart
# As regras específicas ficam em app/.gitignore e app/android/.gitignore
# (gerados pelo flutter create). Aqui, só uma rede de segurança.
# ============================================================
.dart_tool/
build/

# ============================================================
# Backend proxy (Python / FastAPI)
# ============================================================
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ============================================================
# IDEs e sistema
# ============================================================
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.log
*.swp
